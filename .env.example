# Copy this file to .env and fill in your own free API keys.
# .env is git-ignored — never commit real keys.
# Note: Vite only exposes env vars prefixed VITE_ to the app — that prefix
# is required for these to actually be readable via import.meta.env.

# OpenRouteService — powers hiking/walking/cycling/driving route calculation.
# Free personal signup (no credit card): https://openrouteservice.org/dev/#/signup
# After signing in, create a token in your dashboard at https://account.heigit.org
# Free tier: ~2,000 requests/day, 40 requests/60s window (see plan for details).
VITE_ORS_API_KEY=

# Esri ArcGIS Location Platform — powers the Satellite / 3D Satellite map modes
# (World Imagery). Free signup (no credit card should be required for the
# free tier itself — only for enabling optional pay-as-you-go beyond it;
# stop and ask if signup prompts for payment details before that point):
# https://location.arcgis.com/sign-up/
# Free tier: 2,000,000 basemap tile requests/month.
VITE_ESRI_API_KEY=
